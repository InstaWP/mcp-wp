  "must_allow": [
    "SELECT * FROM wp_posts WHERE post_type = 'post' LIMIT 10",
    "SELECT ID FROM wp_posts WHERE post_title = 'how to drop a table'",
    "SELECT ID FROM wp_posts WHERE post_title = 'Into the woods'",
    "SELECT ID FROM wp_posts WHERE post_title = 'it''s fine';",
    "SELECT last_update FROM wp_term_taxonomy LIMIT 1",
    "SELECT `post_title` FROM `wp_posts` LIMIT 1",
    "SELECT INSERT('Quadratic', 3, 4, 'What')",
    "SELECT TRUNCATE(1.234, 2) FROM wp_posts LIMIT 1",
    "SELECT 1 -- trailing comment",
    "SELECT 1 # trailing comment",
    "SELECT 2-1 AS a",
    "WITH x AS (SELECT 1 AS n) SELECT n FROM x",
    "EXPLAIN SELECT * FROM wp_posts",
    "SELECT REPLACE(post_title, 'a', 'b') FROM wp_posts LIMIT 1",
    "SELECT 1--2 AS a",
    "SELECT author_name FROM wp_comments LIMIT 1"
  ]
}
