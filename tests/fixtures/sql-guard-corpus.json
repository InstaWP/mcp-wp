{
  "must_reject": [
    "SELECT LOAD_FILE('/etc/passwd')",
    "SELECT 1 INTO OUTFILE '/tmp/x'",
    "SELECT 1 INTO DUMPFILE '/tmp/x'",
    "SELECT 1 INTO/**/OUTFILE '/tmp/x'",
    "SELECT 1 iNtO oUtFiLe '/tmp/x'",
    "select load_file('/etc/passwd')",
    "SELECT 1 /*!50000;DROP TABLE wp_users*/",
    "SELECT 'x' /*M!50000 INTO OUTFILE '/tmp/pwn' */",
    "SELECT 'x' /*M!!50000 INTO OUTFILE '/tmp/pwn' */",
    "SELECT 'x' /*m!50000 INTO OUTFILE '/tmp/pwn' */",
    "SELECT `LOAD_FILE`('/etc/passwd')",
    "SELECT \"LOAD_FILE\"('/etc/passwd')",
    "SELECT `LOAD_FILE` ('/etc/passwd')",
    "SELECT `LOAD_FILE`/**/('/etc/passwd')",
    "SELECT `LOAD_FILE`#c\n('/etc/passwd')",
    "SELECT `LOAD_FILE`-- c\n('/etc/passwd')",
    "SELECT \"LOAD_FILE\"/**/('/etc/passwd')",
    "SELECT `LOAD_FILE` /**/ ('/etc/passwd')",
    "SELECT `LOAD_FILE`/**//**/('/etc/passwd')",
    "SELECT '#' INTO OUTFILE '/tmp/x'",
    "SELECT '-- ' INTO OUTFILE '/tmp/x'",
    "SELECT 'a\\' , (SELECT 1) INTO OUTFILE '/tmp/x'",
    "SELECT 'abc",
    "SELECT 1 /* abc",
    "SELECT 1; SELECT 2",
    "SELECT 1; DROP TABLE wp_users",
    "SELECT 1 FROM wp_posts DROP",
    "SELECT 1 \u0000",
    "DELETE FROM wp_users",
    "UPDATE wp_users SET x = 1",
    "SELECT `LOAD_FILE`--\u0001\n('/etc/passwd')",
    "SELECT `LOAD_FILE`--\u0007\n('/etc/passwd')",
    "SELECT `LOAD_FILE`--\u001f\n('/etc/passwd')",
    "SELECT `LOAD_FILE`--\u007f\n('/etc/passwd')",
    "SELECT 1 --\u0001\n INTO OUTFILE '/tmp/x'",
    "REPLACE wp_posts SET ID = 1",
    "FLUSH PRIVILEGES",
    "CALL some_procedure()",
    "SHOW GRANTS FOR CURRENT_USER",
    "SELECT 1 UNION REPLACE wp_posts SET ID = 1",
    "SELECT 1 UNION INSERT wp_posts SET ID = 1",
    "SELECT 'a\\'b' AS x"
